generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Reveal {
  id String @id @default(cuid())

  /// Anonymous per-device id (see apps/web/src/lib/clientId.ts). Scopes the
  /// history list to "your" reveals; null for reveals created without one.
  /// Individual reveals stay fetchable by id regardless, since that's the
  /// shareable-link mechanism.
  clientId String? @db.VarChar(64)

  fatherBirthDate DateTime @db.Date
  motherBirthDate DateTime @db.Date
  reckonDate      DateTime @db.Date

  fatherRemainderYears Float
  fatherAngleDeg       Float
  fatherAgeYears       Float

  motherRemainderYears Float
  motherAngleDeg       Float
  motherAgeYears       Float

  newerParent String // "father" | "mother" | "tie"
  motherOlder Boolean
  result      String // "BOY" | "GIRL" | "TIE"

  createdAt DateTime @default(now())

  @@index([clientId])
  @@map("reveals")
}
